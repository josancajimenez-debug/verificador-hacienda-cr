# Materiales de trabajo que no forman parte de la aplicación publicada
PROMT VERIFICADOR.docx
*.docx

# Bibliografía de consulta. Son las fuentes que respaldan las explicaciones de
# los paneles informativos, no material que la aplicación deba distribuir: las
# citas figuran como texto en la interfaz y cada documento está disponible en
# los sitios oficiales que lo publican.
BIBLIOGRAFÍA/

# Paquete comprimido: se regenera; no conviene versionarlo
verificador-hacienda-cr.zip

# Dependencias de las pruebas
node_modules/

# Credenciales en texto plano. Este repositorio es público: la contraseña
# administrativa no debe versionarse nunca. Para cambiarla se generan una sal y
# un hash nuevos (README, sección de personalización) y se guarda la contraseña
# fuera del repositorio o en un gestor de contraseñas.
Contraseña.txt
contrasena.txt
*.secret
.env

